# Provider selection is shared by recorded audio processing and direct browser live voice.
# Supported values: gemini or openai.
AI_PROVIDER=gemini
# Gemini 3.8 Flash handles recorded audio and text.
GEMINI_MODEL=gemini-3.8-flash
# Gemini Live uses the Vertex AI Live API through the local ADC gateway.
# The gateway runs server-side; no Gemini API key is required.
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Puck
LIVE_GATEWAY_URL=ws://127.0.0.1:8787/live
LIVE_GATEWAY_PORT=8787
# OpenAI is optional. Set AI_PROVIDER=openai and provide an OpenAI API key to use it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_LIVE_MODEL=gpt-realtime
OPENAI_REALTIME_TRANSCRIPTION_MODEL=whisper-1
OPENAI_REALTIME_VOICE=marin
# Local: run `gcloud auth application-default login`; deployed workloads should use an attached service account or workload identity.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
# Supabase PostgreSQL and private Storage. These values are server-only.
# Use the modern server-only secret key when available; the legacy service-role key is also supported.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=care-audio
# Direct Google OAuth for the custom application session.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_APP_URL=https://24care.busundo.org
# Generate independent random values of at least 32 characters.
AUTH_JWT_SECRET=
AUTH_REFRESH_SECRET=
# LiveKit server credentials. Keep the API secret server-only.
LIVEKIT_URL=
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
